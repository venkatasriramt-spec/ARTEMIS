# ═══════════════════════════════════════════
# ARTEMIS .gitignore
# ═══════════════════════════════════════════

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.manifest
*.spec

# --- Data (large, generated locally) ---
data/

# --- RL Training Logs & Models ---
versions/*/logs/
versions/*/models/*_steps.zip

# --- Virtual Environments ---
.env
.venv
env/
venv/
ENV/

# --- IDE / Editor ---
.idea/
.vscode/
.spyderproject
.spyproject
.ropeproject
*.swp
*.swo
*~

# --- Jupyter ---
.ipynb_checkpoints

# --- OS ---
.DS_Store
Thumbs.db

# --- Testing ---
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/

# --- Type Checkers ---
.mypy_cache/
.dmypy.json
.pytype/
.pyre/

# --- Misc ---
pip-log.txt
pip-delete-this-directory.txt
cython_debug/
